# Credenciales del servidor institucional, para `npm run deploy:itam`.
#
# A DIFERENCIA de .env.production, este archivo NO se commitea: copia esta
# plantilla a .env.deploy (gitignoreado) y llena los valores. Las variables de
# .env.production son públicas por diseño porque el navegador las descarga de
# todas formas; estas tres dan acceso de escritura al servidor, así que no.
#
# Los valores los da el webmaster de la DSTI del ITAM.

SFTP_HOST=pulsar.itam.mx
SFTP_USER=
SFTP_PASS=
