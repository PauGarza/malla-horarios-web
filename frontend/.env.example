# El build normal NO necesita ninguna variable: el API vive en /api del mismo
# origen que la app, y ese es el valor por defecto en src/lib/api.js.
#
# Copia este archivo a .env solo si necesitas apuntar a otro origen (.env está
# en .gitignore).
#
# Las 3 variables de Supabase que vivían aquí (VITE_DB_URL, VITE_DB_ANON_KEY,
# VITE_LOGIN_FUNCTION_URL) desaparecieron con la migración a MySQL + PHP: ya no
# hay llave pública que exponer, porque ya no hay una app puramente cliente
# hablando directo con la base.

# Solo para apuntar a un API en otro origen. Ojo: eso vuelve a necesitar
# headers CORS en el PHP, que la migración quitó a propósito. Para desarrollo
# local NO hace falta — vite.config.js ya tiene un proxy de /api hacia
# horariosdace.itam.mx.
# VITE_API_URL=https://horariosdace.itam.mx/api
