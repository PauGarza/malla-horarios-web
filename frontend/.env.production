# Variables del build de producción (el que se publica en GitHub Pages).
#
# ESTE ARCHIVO SE COMMITEA A PROPÓSITO — no es una fuga. Las 3 variables son
# públicas por diseño, igual que en .env.example: la protección real de los
# datos vive en RLS (ver ../bd/rls-policies.sql), no en mantener esta llave en
# secreto. Cualquier persona puede leerlas de todas formas abriendo el
# JavaScript que el navegador descarga, así que esconderlas en "secrets" de CI
# daría una sensación de seguridad sin agregar ninguna.
#
# Por qué existe además de .env: .env está en .gitignore (es el de desarrollo
# local de cada quien), así que el build de GitHub Actions no lo ve y saldría
# con las 3 variables en `undefined`. El síntoma sería un "Failed to fetch" al
# iniciar sesión, idéntico al del bug de CORS ya resuelto — fácil de
# diagnosticar mal. Vite carga .env.production automáticamente en `npm run
# build`, sin configuración extra.
#
# Lo que NUNCA va aquí ni en ningún archivo commiteado: la clave de
# administrador de la base y el secreto de firma del JWT. Esos viven solo como
# secrets de la función de login (ver SECRETS-NO-SUBIR.md, fuera de este repo).

VITE_DB_URL=https://gvdgbuktokpfbtdhyiuz.supabase.co
VITE_DB_ANON_KEY=sb_publishable_eHAEN5RkOxakvij6Bnn9_g_SsCFAlv8
VITE_LOGIN_FUNCTION_URL=https://gvdgbuktokpfbtdhyiuz.supabase.co/functions/v1/login
